# Cloudflare Pages: make browsers check for a newer copy of the site's code
# and plotter list on every visit (unchanged files still load from cache).
/js/*
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache
/plotters.json
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache